# sol.env — Phase 4 Sol defaults. `source` me. Every value is overridable
# from the environment; NOTHING here contains a username.
#
# Scheduler values verified by the user on Sol on 2026-10-05:
#   public jobs MUST use --partition=public --qos=public ("general" is rejected)
#   an A100 is --gres=gpu:a100:1 --constraint=a100_80
export P4_ACCOUNT="${P4_ACCOUNT:-grp_tlingego}"
export P4_PARTITION="${P4_PARTITION:-public}"
export P4_QOS="${P4_QOS:-public}"
export P4_GRES="${P4_GRES:-gpu:a100:1}"
export P4_CONSTRAINT="${P4_CONSTRAINT:-a100_80}"

export P4_EXPERIMENT_ROOT="${P4_EXPERIMENT_ROOT:-$HOME/phase4_experiment_sol}"
export P4_CODE_ROOT="${P4_CODE_ROOT:-$P4_EXPERIMENT_ROOT/repo}"
export P4_RESULTS_ROOT="${P4_RESULTS_ROOT:-$P4_EXPERIMENT_ROOT/results}"
export P4_ENV_DIR="${P4_ENV_DIR:-$P4_EXPERIMENT_ROOT/env}"
export P4_SOL="${P4_SOL:-$P4_CODE_ROOT/phase4/code/sol}"

# Models live ONLY in scratch. HF_HUB_CACHE is $HF_HOME/hub (standard layout).
# TRANSFORMERS_CACHE is exported for older transformers only: it is ignored by
# transformers 5.x (zero references in 5.16.1).
export P4_HF_ROOT="${P4_HF_ROOT:-${SCRATCH:-/scratch/${USER:-$(id -un)}}/hf}"
export HF_HOME="$P4_HF_ROOT"
export HF_HUB_CACHE="$P4_HF_ROOT/hub"
export TRANSFORMERS_CACHE="$HF_HUB_CACHE"
export TOKENIZERS_PARALLELISM=false

# submit.sh passes --export=ALL. A P4_FAKE=1 left over from running the tests
# would make a GPU job score with the FAKE scorer and label it as real. Only
# jobs/cpu_tests.slurm sets it, AFTER sourcing this file.
unset P4_FAKE

# The shared PyTorch env the overlay venv sits on. Its NAME says 2.3.1/cu121;
# it actually reported torch 2.11.0+cu130 -- versions are always re-measured.
export P4_SHARED_ENV="${P4_SHARED_ENV:-/packages/envs/pytorch-gpu-2.3.1-cuda-12.1}"
