# sol.env — Phase 3.3 Sol defaults. `source` me. Every value is overridable
# from the environment; NOTHING here contains a username.
#
# Scheduler values verified by the user on Sol on 2026-10-05:
#   public jobs MUST use --partition=public --qos=public ("general" is rejected)
#   an A100 is --gres=gpu:a100:1 --constraint=a100_80
export P33_ACCOUNT="${P33_ACCOUNT:-grp_tlingego}"
export P33_PARTITION="${P33_PARTITION:-public}"
export P33_QOS="${P33_QOS:-public}"
export P33_GRES="${P33_GRES:-gpu:a100:1}"
export P33_CONSTRAINT="${P33_CONSTRAINT:-a100_80}"

export P33_EXPERIMENT_ROOT="${P33_EXPERIMENT_ROOT:-$HOME/phase3-3_experiment_sol}"
export P33_CODE_ROOT="${P33_CODE_ROOT:-$P33_EXPERIMENT_ROOT/repo}"
export P33_RESULTS_ROOT="${P33_RESULTS_ROOT:-$P33_EXPERIMENT_ROOT/results}"
export P33_ENV_DIR="${P33_ENV_DIR:-$P33_EXPERIMENT_ROOT/env}"
export P33_SOL="${P33_SOL:-$P33_CODE_ROOT/phase3_2/sol}"

# Models live ONLY in scratch. HF_HUB_CACHE is $HF_HOME/hub (standard layout).
# TRANSFORMERS_CACHE is exported for older transformers only: it is ignored by
# transformers 5.x (zero references in 5.16.1).
export P33_HF_ROOT="${P33_HF_ROOT:-${SCRATCH:-/scratch/${USER:-$(id -un)}}/hf}"
export HF_HOME="$P33_HF_ROOT"
export HF_HUB_CACHE="$P33_HF_ROOT/hub"
export TRANSFORMERS_CACHE="$HF_HUB_CACHE"
export TOKENIZERS_PARALLELISM=false

# submit.sh passes --export=ALL. A P33_FAKE=1 left over from running the tests
# would make a GPU job score with the FAKE scorer and label it as real. Only
# jobs/cpu_tests.slurm sets it, AFTER sourcing this file.
unset P33_FAKE

# The shared PyTorch env the overlay venv sits on. Its NAME says 2.3.1/cu121;
# it actually reported torch 2.11.0+cu130 -- versions are always re-measured.
export P33_SHARED_ENV="${P33_SHARED_ENV:-/packages/envs/pytorch-gpu-2.3.1-cuda-12.1}"
